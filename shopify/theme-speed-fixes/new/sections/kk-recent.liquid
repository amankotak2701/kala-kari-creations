{% render 'kk-base' %}

{%- comment -%}
  Recently viewed: remembers the products a visitor opens (in their own browser) and shows them
  again. On a product page it also records that product. Hidden until there is something to show.
{%- endcomment -%}

<section
  class="kk kk-recent"
  data-kk-recent
  data-current="{{ product.handle }}"
  data-limit="{{ section.settings.limit }}"
  hidden
>
  <div class="kk-wrap kk-center">
    {%- if section.settings.eyebrow != blank -%}
      <span class="kk-eyebrow">{{ section.settings.eyebrow }}</span>
    {%- endif -%}
    <h2 class="kk-title">{{ section.settings.heading }}</h2>
    <hr class="kk-rule">
    <div class="kk-recent__grid" data-kk-recent-grid></div>
  </div>
</section>

{% stylesheet %}
  .kk-recent { background: var(--kk-ivory); padding: 80px 0; }
  .kk-recent[hidden] { display: none; }
  .kk-recent__grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 26px; margin-top: 44px; text-align: left; }
  @media (max-width: 900px) {
    .kk-recent { padding: 56px 0; }
    .kk-recent__grid { display: flex; gap: 14px; overflow-x: auto; scroll-snap-type: x mandatory; margin: 32px -24px 0; padding: 0 24px 8px; }
    .kk-recent__grid > .kk-card { flex: 0 0 44%; scroll-snap-align: start; }
  }
{% endstylesheet %}

{% javascript %}
  (function () {
    var KEY = 'kk_recently_viewed';
    var MAX_STORED = 12;

    function read() {
      try {
        var list = JSON.parse(localStorage.getItem(KEY) || '[]');
        return Array.isArray(list) ? list : [];
      } catch (e) {
        return [];
      }
    }

    function write(list) {
      try {
        localStorage.setItem(KEY, JSON.stringify(list.slice(0, MAX_STORED)));
      } catch (e) {}
    }

    function init(root) {
      root.querySelectorAll('[data-kk-recent]').forEach(setup);
    }

    function setup(section) {
      if (section.dataset.kkReady) return;
      section.dataset.kkReady = '1';

      var current = section.dataset.current;
      var limit = parseInt(section.dataset.limit, 10) || 4;
      var list = read();

      // Show what was viewed before this page, then remember this product at the front.
      var handles = list.filter(function (h) { return h !== current; }).slice(0, limit);
      if (current) write([current].concat(list.filter(function (h) { return h !== current; })));
      if (!handles.length) return;

      var root_url = (window.Shopify && Shopify.routes && Shopify.routes.root) || '/';
      Promise.all(handles.map(function (h) {
        return fetch(root_url + 'products/' + encodeURIComponent(h) + '?view=kk-card')
          .then(function (r) { return r.ok ? r.text() : ''; })
          .catch(function () { return ''; });
      })).then(function (cards) {
        var grid = section.querySelector('[data-kk-recent-grid]');
        var gone = [];
        cards.forEach(function (html, i) {
          if (html.indexOf('kk-card') === -1) { gone.push(handles[i]); return; }
          grid.insertAdjacentHTML('beforeend', html);
        });
        // Forget products that no longer exist.
        if (gone.length) write(read().filter(function (h) { return gone.indexOf(h) === -1; }));
        // Cards fetched after load would otherwise stay hidden by the scroll-reveal styles.
        grid.querySelectorAll('.kk-rv').forEach(function (el) { el.classList.remove('kk-rv'); });
        if (grid.children.length) section.hidden = false;
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', function () { init(document); });
    } else { init(document); }
    document.addEventListener('shopify:section:load', function (e) { init(e.target); });
  })();
{% endjavascript %}

{% schema %}
{
  "name": "Recently viewed",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "Pick up where you left off" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Recently viewed" },
    { "type": "range", "id": "limit", "label": "Products to show", "min": 2, "max": 8, "step": 1, "default": 4 },
    { "type": "paragraph", "content": "Shows the products this visitor opened before, saved in their own browser. Stays hidden until they have viewed at least one other product." }
  ],
  "presets": [{ "name": "Recently viewed" }]
}
{% endschema %}
