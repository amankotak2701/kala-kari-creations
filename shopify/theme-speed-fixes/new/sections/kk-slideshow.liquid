{% render 'kk-base' %}

<section class="kk kk-ss" id="kk-ss-{{ section.id }}" data-autoplay="{{ section.settings.autoplay_seconds }}">
  <div class="kk-ss__slides">
    {%- for block in section.blocks -%}
      <div class="kk-ss__slide kk-ss__slide--{{ block.settings.layout }}{% if forloop.first %} is-active{% endif %}" {{ block.shopify_attributes }} aria-hidden="{% if forloop.first %}false{% else %}true{% endif %}">
        <div class="kk-ss__media">
          {%- if block.settings.image != blank -%}
            {%- assign load = 'lazy' -%}
            {%- assign priority = 'auto' -%}
            {%- if forloop.first -%}{%- assign load = 'eager' -%}{%- assign priority = 'high' -%}{%- endif -%}
            {%- assign focal_style = block.settings.focal | default: 'center 30%' | prepend: 'object-position: ' -%}
            {{ block.settings.image | image_url: width: 2400 | image_tag: loading: load, fetchpriority: priority, sizes: '100vw', widths: '750, 1100, 1500, 2000, 2400', alt: block.settings.image.alt, style: focal_style }}
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag }}
          {%- endif -%}
        </div>
        <div class="kk-ss__content">
          <div class="kk-ss__inner">
            {%- if block.settings.eyebrow != blank -%}<span class="kk-eyebrow kk-ss__eyebrow">{{ block.settings.eyebrow }}</span>{%- endif -%}
            <h2 class="kk-ss__title">
              {{- block.settings.heading -}}
              {%- if block.settings.heading_italic != blank -%}<br><em>{{ block.settings.heading_italic }}</em>{%- endif -%}
            </h2>
            {%- if block.settings.text != blank -%}<p class="kk-ss__text">{{ block.settings.text }}</p>{%- endif -%}
            <div class="kk-ss__ctas">
              {%- if block.settings.button_label != blank -%}
                <a class="kk-ss__btn kk-ss__btn--solid" href="{{ block.settings.button_link | default: routes.all_products_collection_url }}">{{ block.settings.button_label }}</a>
              {%- endif -%}
              {%- if block.settings.button2_label != blank -%}
                <a class="kk-ss__btn kk-ss__btn--ghost" href="{{ block.settings.button2_link | default: routes.collections_url }}">{{ block.settings.button2_label }}</a>
              {%- endif -%}
            </div>
          </div>
        </div>
      </div>
    {%- endfor -%}
  </div>
  {%- if section.blocks.size > 1 -%}
    <div class="kk-ss__nav">
      {%- for block in section.blocks -%}
        <button type="button" class="kk-ss__dot{% if forloop.first %} is-active{% endif %}" aria-label="Show slide {{ forloop.index }}" data-index="{{ forloop.index0 }}"></button>
      {%- endfor -%}
    </div>
  {%- endif -%}
</section>

<script>
  (function () {
    var root = document.getElementById('kk-ss-{{ section.id }}');
    if (!root) return;
    var slides = root.querySelectorAll('.kk-ss__slide');
    var dots = root.querySelectorAll('.kk-ss__dot');
    if (slides.length < 2) return;
    // Hidden slides would otherwise wait to load until they are shown, and fade in empty.
    function warm() { root.querySelectorAll('img[loading="lazy"]').forEach(function (img) { img.loading = 'eager'; }); }
    if (document.readyState === 'complete') warm(); else window.addEventListener('load', warm);
    var i = 0, timer, secs = parseInt(root.dataset.autoplay, 10) || 0;
    function go(n) {
      slides[i].classList.remove('is-active'); slides[i].setAttribute('aria-hidden', 'true');
      if (dots[i]) dots[i].classList.remove('is-active');
      i = (n + slides.length) % slides.length;
      slides[i].classList.add('is-active'); slides[i].setAttribute('aria-hidden', 'false');
      if (dots[i]) dots[i].classList.add('is-active');
    }
    function start() {
      stop();
      if (secs > 0 && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        timer = setInterval(function () { go(i + 1); }, secs * 1000);
      }
    }
    function stop() { if (timer) clearInterval(timer); }
    dots.forEach(function (d) { d.addEventListener('click', function () { go(+d.dataset.index); start(); }); });
    root.addEventListener('mouseenter', stop);
    root.addEventListener('mouseleave', start);
    var x0 = null;
    root.addEventListener('touchstart', function (e) { x0 = e.touches[0].clientX; }, { passive: true });
    root.addEventListener('touchend', function (e) {
      if (x0 === null) return;
      var dx = e.changedTouches[0].clientX - x0;
      if (Math.abs(dx) > 40) { go(dx < 0 ? i + 1 : i - 1); start(); }
      x0 = null;
    });
    document.addEventListener('shopify:block:select', function (e) {
      var idx = Array.prototype.indexOf.call(slides, e.target);
      if (idx > -1) { stop(); go(idx); }
    });
    start();
  })();
</script>

{% stylesheet %}
  .kk-ss { position: relative; background: var(--kk-ink); overflow: hidden; }
  .kk-ss__slides { position: relative; min-height: 88vh; }
  .kk-ss__slide { position: absolute; inset: 0; opacity: 0; visibility: hidden; transition: opacity 1.1s ease, visibility 0s linear 1.1s; }
  .kk-ss__slide.is-active { opacity: 1; visibility: visible; transition: opacity 1.1s ease; z-index: 1; }
  .kk-ss__media { position: absolute; inset: 0; overflow: hidden; }
  .kk-ss__media img, .kk-ss__media svg { width: 100%; height: 100%; object-fit: cover; transform: scale(1.12); }
  .kk-ss__slide.is-active .kk-ss__media img { animation: kk-ss-zoom 9s ease-out forwards; }
  @keyframes kk-ss-zoom { from { transform: scale(1.14); } to { transform: scale(1.02); } }
  .kk-ss__slide--full .kk-ss__media::after { content: ""; position: absolute; inset: 0; background: linear-gradient(90deg, rgba(26,18,15,.66) 0%, rgba(26,18,15,.3) 50%, rgba(26,18,15,.04) 100%); }
  .kk-ss__content { position: relative; z-index: 2; height: 100%; min-height: 88vh; display: flex; align-items: center; }
  .kk-ss__inner { max-width: 620px; padding: 90px 24px 110px max(24px, calc((100vw - 1280px) / 2 + 24px)); color: var(--kk-ivory); }
  .kk-ss__eyebrow { color: var(--kk-gold-bright) !important; }
  .kk-ss__title { font-family: var(--kk-serif); font-weight: 500; font-size: clamp(42px, 6vw, 84px); line-height: 1.06; margin: 16px 0 0; color: inherit; }
  .kk-ss__title em { font-style: italic; color: var(--kk-gold-bright); }
  .kk-ss__text { margin: 22px 0 34px; font-size: 17px; font-weight: 300; max-width: 460px; }
  .kk-ss__ctas { display: flex; gap: 14px; flex-wrap: wrap; }
  .kk-ss__btn { display: inline-block; padding: 15px 34px; font-size: 12px; letter-spacing: .25em; text-transform: uppercase; font-weight: 500; transition: background .3s, color .3s, border-color .3s; border: 1px solid transparent; }
  .kk-ss__btn--solid { background: var(--kk-maroon); color: var(--kk-ivory); }
  .kk-ss__btn--solid:hover { background: var(--kk-ivory); color: var(--kk-maroon); }
  .kk-ss__btn--ghost { border-color: currentColor; color: inherit; }
  .kk-ss__btn--ghost:hover { background: var(--kk-ivory); color: var(--kk-ink); border-color: var(--kk-ivory); }
  .kk-ss__slide--split { background: var(--kk-ivory-d); }
  .kk-ss__slide--split .kk-ss__media { left: auto; width: 50%; }
  .kk-ss__slide--split .kk-ss__inner { color: var(--kk-ink); max-width: 50%; }
  .kk-ss__slide--split .kk-ss__eyebrow { color: var(--kk-gold) !important; }
  .kk-ss__slide--split .kk-ss__title em { color: var(--kk-maroon); }
  .kk-ss__slide--split .kk-ss__btn--ghost:hover { background: var(--kk-ink); color: var(--kk-ivory); border-color: var(--kk-ink); }
  .kk-ss__nav { position: absolute; z-index: 3; left: 0; right: 0; bottom: 34px; display: flex; justify-content: center; gap: 12px; }
  .kk-ss__dot { width: 36px; height: 3px; padding: 0; border: 0; background: rgba(205,168,92,.4); cursor: pointer; transition: background .3s, width .3s; }
  .kk-ss__dot.is-active { background: var(--kk-gold-bright); width: 56px; }
  @media (max-width: 800px) {
    .kk-ss__slides, .kk-ss__content { min-height: 90vh; }
    .kk-ss__content { align-items: flex-end; }
    .kk-ss__inner, .kk-ss__slide--split .kk-ss__inner { max-width: none; padding: 0 24px 86px; color: var(--kk-ivory); }
    .kk-ss__slide--full .kk-ss__media::after, .kk-ss__slide--split .kk-ss__media::after { content: ""; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(26,18,15,.1) 30%, rgba(26,18,15,.82) 80%); }
    .kk-ss__slide--split .kk-ss__media { width: 100%; }
    .kk-ss__slide--split .kk-ss__eyebrow { color: var(--kk-gold-bright) !important; }
    .kk-ss__slide--split .kk-ss__title em { color: var(--kk-gold-bright); }
    .kk-ss__media img { object-position: center top !important; }
    .kk-ss__text { font-size: 15px; margin: 14px 0 24px; }
    .kk-ss__btn { padding: 13px 22px; }
  }
  @media (prefers-reduced-motion: reduce) { .kk-ss__slide.is-active .kk-ss__media img { animation: none; transform: none; } }
{% endstylesheet %}

{% schema %}
{
  "name": "Kala Kari slideshow",
  "tag": "div",
  "settings": [
    { "type": "range", "id": "autoplay_seconds", "label": "Seconds per slide (0 = off)", "min": 0, "max": 12, "step": 1, "default": 6 }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "select", "id": "layout", "label": "Layout", "default": "full", "options": [{ "value": "full", "label": "Full image" }, { "value": "split", "label": "Text left, photo right" }] },
        { "type": "text", "id": "focal", "label": "Image focus (CSS object-position)", "default": "center 30%" },
        { "type": "text", "id": "eyebrow", "label": "Small label" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Tradition," },
        { "type": "text", "id": "heading_italic", "label": "Heading (italic line)", "default": "Beautifully Worn." },
        { "type": "textarea", "id": "text", "label": "Text" },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop now" },
        { "type": "url", "id": "button_link", "label": "Button link" },
        { "type": "text", "id": "button2_label", "label": "Second button label" },
        { "type": "url", "id": "button2_link", "label": "Second button link" }
      ]
    }
  ],
  "max_blocks": 5,
  "presets": [{ "name": "Kala Kari slideshow", "blocks": [{ "type": "slide" }, { "type": "slide" }] }]
}
{% endschema %}
