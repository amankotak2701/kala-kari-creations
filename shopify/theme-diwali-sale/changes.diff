+  # Diwali Dhamaka Sale (snippets/kk-sale): show the store-wide discount as the sale price
+  capture sale_pct
+    render 'kk-sale', mode: 'pct'
+  endcapture
+  if sale_pct != blank and product_resource != blank
+    unless compare_at_price > price
+      assign compare_at_price = price
+    endunless
+    assign keep = 100 | minus: sale_pct
+    assign price = price | times: keep | divided_by: 100
+  endif
+
   assign show_compare_price = false
   if compare_at_price > price
     assign show_compare_price = true
