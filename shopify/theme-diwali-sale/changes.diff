diff -ruN orig/snippets/kk-sale.liquid new/snippets/kk-sale.liquid
--- orig/snippets/kk-sale.liquid	1970-01-01 00:00:00.000000000 +0000
+++ new/snippets/kk-sale.liquid	2026-10-25 05:06:31.377925438 +0000
@@ -0,0 +1,36 @@
+{%- comment -%}
+  Diwali Dhamaka Sale: the store-wide % off given by the automatic discount in Shopify admin.
+  Keep the percentage and dates here the same as that discount; outside the dates nothing changes.
+  mode 'pct'   prints the percentage while the sale is on (blank otherwise); use it with capture.
+  mode 'price' (default) prints the card price: sale price, then the original struck through.
+  Accepts: mode, price, compare_at_price, from (true adds "From").
+{%- endcomment -%}
+{%- liquid
+  assign pct = 20
+  assign start_s = '2026-10-25 00:00:00 +0530' | date: '%s' | plus: 0
+  assign end_s = '2026-11-09 23:59:59 +0530' | date: '%s' | plus: 0
+  assign now_s = 'now' | date: '%s' | plus: 0
+  assign live = false
+  if now_s >= start_s and now_s <= end_s
+    assign live = true
+  endif
+-%}
+{%- if mode == 'pct' -%}
+  {%- if live -%}{{ pct }}{%- endif -%}
+{%- else -%}
+  {%- if from -%}From {% endif -%}
+  {%- if live -%}
+    {%- liquid
+      assign keep = 100 | minus: pct
+      assign sale = price | times: keep | divided_by: 100
+      assign was = price
+      if compare_at_price > price
+        assign was = compare_at_price
+      endif
+    -%}
+    {{ sale | money }}<s>{{ was | money }}</s>
+  {%- else -%}
+    {{ price | money }}
+    {%- if compare_at_price > price -%}<s>{{ compare_at_price | money }}</s>{%- endif -%}
+  {%- endif -%}
+{%- endif -%}
