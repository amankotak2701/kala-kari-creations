{%- comment -%}
  Kala Kari redesign: shared tokens, type and scroll-reveal used by all kk-* sections.
{%- endcomment -%}
<script>document.documentElement.classList.add('kk-js');</script>

{% stylesheet %}
  :root {
    --kk-ivory: #F7F2E9;
    --kk-ivory-d: #EFE8DA;
    --kk-ink: #2B2320;
    --kk-ink-deep: #1E1815;
    --kk-ink-soft: #4a3f3a;
    --kk-maroon: #752C39;
    --kk-gold: #A9833A;
    --kk-gold-bright: #CDA85C;
    --kk-serif: var(--font-heading--family), 'Cormorant Garamond', 'Cormorant', Georgia, serif;
    --kk-sans: var(--font-body--family), 'Jost', 'Helvetica Neue', Arial, sans-serif;
  }
  .kk { font-family: var(--kk-sans); color: var(--kk-ink); line-height: 1.6; }
  /* Zero-specificity resets so component classes (buttons, links) always win. */
  :where(.kk) *, :where(.kk) *::before, :where(.kk) *::after { box-sizing: border-box; }
  :where(.kk) img { display: block; max-width: 100%; }
  :where(.kk) a { color: inherit; text-decoration: none; }
  .kk-wrap { max-width: 1280px; margin: 0 auto; padding: 0 24px; }
  .kk-center { text-align: center; }
  .kk-eyebrow { display: block; font-family: var(--kk-sans); font-size: 12px; letter-spacing: .35em; text-transform: uppercase; color: var(--kk-gold); font-weight: 500; margin: 0; }
  .kk-title { font-family: var(--kk-serif); font-weight: 500; font-size: clamp(32px, 4vw, 52px); line-height: 1.12; margin: 10px 0 0; color: inherit; }
  .kk-title em { font-style: italic; }
  .kk-rule { width: 64px; height: 2px; background: var(--kk-gold); margin: 18px auto; border: 0; }
  .kk-btn { display: inline-block; padding: 15px 42px; border: 1px solid var(--kk-ink); font-family: var(--kk-sans); font-size: 13px; letter-spacing: .25em; text-transform: uppercase; font-weight: 500; transition: background .3s, color .3s, border-color .3s; background: transparent; color: var(--kk-ink); cursor: pointer; }
  .kk-btn:hover { background: var(--kk-ink); color: var(--kk-ivory); }
  .kk-btn--light { border-color: var(--kk-ivory); color: var(--kk-ivory); }
  .kk-btn--light:hover { background: var(--kk-ivory); color: var(--kk-ink); }
  /* Scroll reveal. Once an element has faded in, the script removes these classes so its own
     hover transitions (buttons, cards) work again without the reveal delay. */
  .kk-js .kk-rv { opacity: 0; transform: translateY(26px); transition: opacity .9s ease, transform .9s ease; }
  .kk-js .kk-rv.kk-in { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) {
    .kk-js .kk-rv { opacity: 1; transform: none; transition: none; }
  }
  .shopify-design-mode .kk-rv { opacity: 1 !important; transform: none !important; }
  /* Shared video player (snippets/kk-video). */
  .kk-vid { cursor: pointer; }
  .kk-vid__play { position: absolute; inset: 10px; z-index: 1; display: flex; align-items: center; justify-content: center; padding: 0; border: 0; background: rgba(30,24,21,.18); cursor: pointer; }
  .kk-vid__play[hidden] { display: none; }
  .kk-vid__play span { display: flex; align-items: center; justify-content: center; width: 72px; height: 72px; padding-left: 5px; border-radius: 50%; background: rgba(247,242,233,.94); color: var(--kk-maroon); font-size: 24px; box-shadow: 0 6px 24px rgba(0,0,0,.25); transition: transform .25s; }
  .kk-vid__play:hover span { transform: scale(1.06); }
  /* Section accents that must win over the shared base rules above. */
  .kk .kk-film__title { color: var(--kk-ivory); }
  .kk .kk-film__rule { background: var(--kk-gold-bright); }
  .kk .kk-hero__eyebrow, .kk .kk-film__eyebrow, .kk .kk-story__eyebrow { color: var(--kk-gold-bright); }
  .kk.kk-fest, .kk.kk-proc, .kk.kk-news { color: var(--kk-ivory); }
  .kk .kk-fest__btn { color: var(--kk-ivory); }
  .kk .kk-fest__btn:hover { color: var(--kk-maroon); }
  .kk .kk-fest__btn--solid { color: var(--kk-ink); }
  /* Slideshow: rest at the zoom's end scale so a slide leaving the screen doesn't jump in size. */
  .kk .kk-ss__media img, .kk .kk-ss__media svg { transform: scale(1.02); }
  .kk .kk-hero__img { object-position: 70% 30%; }
  @media (max-width: 700px) { .kk .kk-hero__img { object-position: 55% top; } }
{% endstylesheet %}

{% javascript %}
  (function () {
    function settle(el) {
      // Reveal finished: drop the reveal classes and delay so the element's own transitions apply.
      el.classList.remove('kk-rv', 'kk-in');
      el.style.transitionDelay = '';
    }
    function reveal(root) {
      var els = (root || document).querySelectorAll('.kk-rv:not(.kk-in)');
      if (!('IntersectionObserver' in window)) {
        els.forEach(settle);
        return;
      }
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          if (!e.isIntersecting) return;
          var el = e.target;
          io.unobserve(el);
          el.classList.add('kk-in');
          setTimeout(function () { settle(el); }, (parseInt(el.dataset.kkDelay, 10) || 0) + 950);
        });
      }, { threshold: 0.12 });
      els.forEach(function (el) {
        el.style.transitionDelay = (el.dataset.kkDelay || 0) + 'ms';
        io.observe(el);
      });
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', function () { reveal(); });
    } else { reveal(); }
    document.addEventListener('shopify:section:load', function (e) { reveal(e.target); });
  })();
{% endjavascript %}
