{%- comment -%}
  Kala Kari offer: a coupon bar (header) or banner (page), shown only between the start and end dates.
  Dates are checked when the page renders and again in the browser, so a cached page still hides on time.
{%- endcomment -%}
{%- liquid
  assign now_s = 'now' | date: '%s' | plus: 0
  assign start_s = section.settings.starts | date: '%s' | plus: 0
  assign end_s = section.settings.ends | date: '%s' | plus: 0
  assign live = true
  if section.settings.starts != blank and now_s < start_s
    assign live = false
  endif
  if section.settings.ends != blank and now_s > end_s
    assign live = false
  endif
  if request.design_mode
    assign live = true
  endif
  assign code = section.settings.code | strip | upcase
  assign shop_path = section.settings.redirect | default: '/collections/all'
  assign shop_url = '/discount/' | append: code | append: '?redirect=' | append: shop_path
-%}
{%- if live and code != blank -%}
  {%- if section.settings.style == 'bar' -%}
    <div class="kk-offer kk-offer--bar{% if section.settings.effects %} kk-offer--fx{% endif %}" id="kk-offer-{{ section.id }}" data-ends="{{ end_s }}" role="region" aria-label="{{ section.settings.label }}">
      <span class="kk-offer__tag"><span class="kk-offer__twinkle" aria-hidden="true">&#10022;</span> {{ section.settings.label }}</span>
      <span class="kk-offer__text">{{ section.settings.bar_text }}</span>
      <button type="button" class="kk-offer__code" data-code="{{ code }}" aria-label="Copy code {{ code }}">
        {{ code }}<span class="kk-offer__copy">Copy</span>
      </button>
      {%- if section.settings.dates != blank -%}<span class="kk-offer__dates">{{ section.settings.dates }}</span>{%- endif -%}
      <a class="kk-offer__cta" href="{{ shop_url }}">Shop now &rarr;</a>
    </div>
  {%- else -%}
    <section class="kk kk-offer kk-offer--banner{% if section.settings.effects %} kk-offer--fx{% endif %}" id="kk-offer-{{ section.id }}" data-ends="{{ end_s }}">
      {%- if section.settings.effects -%}
        <div class="kk-offer__toran" aria-hidden="true"></div>
        <div class="kk-offer__sparkles" aria-hidden="true">
          {%- for i in (1..18) -%}
            {%- assign x = i | times: 37 | modulo: 97 | plus: 1 -%}
            {%- assign w = i | times: 7 | modulo: 60 | divided_by: 10.0 -%}
            {%- assign d = i | modulo: 5 | plus: 7 -%}
            {%- assign m = i | modulo: 3 -%}
            {%- assign s = m | times: 5 | plus: 9 -%}
            <span style="--x: {{ x }}%; --w: {{ w }}s; --d: {{ d }}s; --s: {{ s }}px;">{% if m == 0 %}&#8226;{% else %}&#10022;{% endif %}</span>
          {%- endfor -%}
        </div>
        {%- capture diya -%}
          <svg viewBox="0 0 64 64" width="64" height="64" focusable="false"><ellipse class="kk-diya__glow" cx="32" cy="22" rx="16" ry="18"/><path class="kk-diya__flame" d="M32 6c5 8 8 12 8 18a8 8 0 0 1-16 0c0-6 3-10 8-18z"/><path class="kk-diya__core" d="M32 16c2.5 4 4 6 4 9a4 4 0 0 1-8 0c0-3 1.5-5 4-9z"/><path class="kk-diya__bowl" d="M6 36h52c-2 12-12 20-26 20S8 48 6 36z"/><path class="kk-diya__rim" d="M6 36h52" /></svg>
        {%- endcapture -%}
        <span class="kk-diya kk-diya--l" aria-hidden="true">{{ diya }}</span>
        <span class="kk-diya kk-diya--r" aria-hidden="true">{{ diya }}</span>
      {%- endif -%}
      <div class="kk-offer__inner">
        <span class="kk-offer__motif" aria-hidden="true">&#10022; &#10022; &#10022;</span>
        <span class="kk-eyebrow kk-offer__eyebrow">{{ section.settings.label }}{% if section.settings.dates != blank %} · {{ section.settings.dates }}{% endif %}</span>
        <h2 class="kk-offer__title">{{ section.settings.heading }}{% if section.settings.heading_italic != blank %}<br><em>{{ section.settings.heading_italic }}</em>{% endif %}</h2>
        {%- if section.settings.text != blank -%}<p class="kk-offer__body">{{ section.settings.text }}</p>{%- endif -%}
        <div class="kk-offer__actions">
          <button type="button" class="kk-offer__code kk-offer__code--lg" data-code="{{ code }}" aria-label="Copy code {{ code }}">
            <small>Use code</small>{{ code }}<span class="kk-offer__copy">Tap to copy</span>
          </button>
          <a class="kk-offer__btn" href="{{ shop_url }}">{{ section.settings.button_label | default: 'Shop now' }}</a>
        </div>
        {%- if section.settings.fine_print != blank -%}<p class="kk-offer__fine">{{ section.settings.fine_print }}</p>{%- endif -%}
      </div>
    </section>
  {%- endif -%}
  <script>
    (function () {
      var root = document.getElementById('kk-offer-{{ section.id }}');
      if (!root) return;
      var ends = parseInt(root.dataset.ends, 10);
      if (ends && Date.now() / 1000 > ends && !window.Shopify?.designMode) { root.remove(); return; }
      root.querySelectorAll('.kk-offer__code').forEach(function (btn) {
        var label = btn.querySelector('.kk-offer__copy');
        var original = label ? label.textContent : '';
        btn.addEventListener('click', function () {
          var code = btn.dataset.code;
          function done() {
            if (label) label.textContent = 'Copied!';
            btn.classList.add('is-copied');
            setTimeout(function () { if (label) label.textContent = original; btn.classList.remove('is-copied'); }, 2000);
          }
          if (navigator.clipboard && window.isSecureContext) {
            navigator.clipboard.writeText(code).then(done, done);
          } else {
            var t = document.createElement('textarea');
            t.value = code; t.setAttribute('readonly', ''); t.style.position = 'fixed'; t.style.opacity = '0';
            document.body.appendChild(t); t.select();
            try { document.execCommand('copy'); } catch (e) {}
            t.remove(); done();
          }
        });
      });
    })();
  </script>
{%- endif -%}

{% stylesheet %}
  .kk-offer { --kk-offer-gold: #CDA85C; --kk-offer-ivory: #F7F2E9; --kk-offer-maroon: #752C39; }
  .kk-offer__code { display: inline-flex; align-items: center; gap: 8px; border: 1px dashed var(--kk-offer-gold); background: rgba(205,168,92,.14); color: var(--kk-offer-ivory); font: inherit; font-weight: 600; letter-spacing: .18em; cursor: pointer; transition: background .25s, color .25s; }
  .kk-offer__code:hover, .kk-offer__code.is-copied { background: var(--kk-offer-gold); color: #2B2320; }
  .kk-offer__copy { font-size: .8em; font-weight: 500; letter-spacing: .12em; opacity: .85; }

  /* Bar (header, every page) */
  .kk-offer--bar { display: flex; align-items: center; justify-content: center; flex-wrap: wrap; gap: 6px 14px; padding: 9px 16px; background: var(--kk-offer-maroon); color: var(--kk-offer-ivory); font-family: var(--font-body--family), 'Jost', sans-serif; font-size: 13px; line-height: 1.3; text-align: center; }
  .kk-offer--bar .kk-offer__tag { font-size: 11px; letter-spacing: .24em; text-transform: uppercase; color: var(--kk-offer-gold); font-weight: 600; }
  .kk-offer--bar .kk-offer__code { padding: 4px 10px; font-size: 12px; }
  .kk-offer--bar .kk-offer__dates { font-size: 12px; opacity: .8; }
  .kk-offer--bar .kk-offer__cta { color: var(--kk-offer-ivory); font-size: 12px; letter-spacing: .14em; text-transform: uppercase; text-decoration: none; border-bottom: 1px solid var(--kk-offer-gold); }
  @media (max-width: 600px) {
    .kk-offer--bar { font-size: 12px; gap: 6px 10px; padding: 8px 12px; }
    .kk-offer--bar .kk-offer__tag, .kk-offer--bar .kk-offer__dates { display: none; }
  }

  /* Banner (homepage) */
  .kk-offer--banner { position: relative; background: var(--kk-offer-maroon); color: var(--kk-offer-ivory); padding: 72px 24px; text-align: center; overflow: hidden; }
  .kk-offer--banner::before { content: ""; position: absolute; inset: 16px; border: 1px solid rgba(205,168,92,.45); pointer-events: none; }
  .kk-offer__inner { position: relative; max-width: 760px; margin: 0 auto; }
  .kk-offer__motif { display: block; color: var(--kk-offer-gold); letter-spacing: .6em; font-size: 14px; margin-bottom: 16px; }
  .kk .kk-offer__eyebrow { color: var(--kk-offer-gold); }
  .kk-offer__title { font-family: var(--kk-serif); font-weight: 500; font-size: clamp(34px, 5vw, 62px); line-height: 1.08; margin: 14px 0 0; color: var(--kk-offer-ivory); }
  .kk-offer__title em { font-style: italic; color: var(--kk-offer-gold); }
  .kk-offer__body { margin: 18px auto 0; max-width: 560px; font-size: 16px; font-weight: 300; color: #f1e3e5; }
  .kk-offer__actions { display: flex; justify-content: center; align-items: stretch; flex-wrap: wrap; gap: 14px; margin-top: 30px; }
  .kk-offer__code--lg { flex-direction: column; gap: 2px; padding: 10px 26px; font-size: 22px; }
  .kk-offer__code--lg small { font-size: 10px; font-weight: 500; letter-spacing: .28em; text-transform: uppercase; opacity: .85; }
  .kk-offer__code--lg .kk-offer__copy { font-size: 10px; letter-spacing: .2em; text-transform: uppercase; }
  .kk-offer__btn { display: inline-flex; align-items: center; padding: 15px 34px; background: var(--kk-offer-gold); border: 1px solid var(--kk-offer-gold); color: #2B2320; font-size: 12px; font-weight: 500; letter-spacing: .25em; text-transform: uppercase; text-decoration: none; transition: background .3s, border-color .3s; }
  .kk-offer__btn:hover { background: var(--kk-offer-ivory); border-color: var(--kk-offer-ivory); }
  .kk-offer__fine { margin: 22px 0 0; font-size: 12px; color: #e2cfd2; opacity: .85; }
  @media (max-width: 600px) { .kk-offer--banner { padding: 56px 20px; } .kk-offer--banner::before { inset: 10px; } }

  /* ---------- Festive effects (CSS only; switched off for reduced-motion users) ---------- */
  @keyframes kk-shine { 0% { transform: translateX(-120%) skewX(-20deg); } 55%, 100% { transform: translateX(320%) skewX(-20deg); } }
  @keyframes kk-pulse { 0%, 100% { box-shadow: 0 0 0 0 rgba(205,168,92,.6); } 50% { box-shadow: 0 0 0 7px rgba(205,168,92,0); } }
  @keyframes kk-twinkle { 0%, 100% { opacity: .35; transform: scale(.75) rotate(0); } 50% { opacity: 1; transform: scale(1.2) rotate(25deg); } }
  @keyframes kk-rise { 0% { transform: translateY(0) scale(.6); opacity: 0; } 15% { opacity: 1; } 80% { opacity: .9; } 100% { transform: translateY(-460px) scale(1.1); opacity: 0; } }
  @keyframes kk-sway { 0%, 100% { transform: rotate(-.6deg); } 50% { transform: rotate(.6deg); } }
  @keyframes kk-text-shine { to { background-position: -200% center; } }
  @keyframes kk-flicker { 0%, 100% { transform: scale(1, 1) translateY(0); opacity: 1; } 25% { transform: scale(.92, 1.08) translateY(-1px); opacity: .9; } 50% { transform: scale(1.06, .94); opacity: 1; } 75% { transform: scale(.96, 1.05) translateY(-1px); opacity: .85; } }
  @keyframes kk-glow { 0%, 100% { opacity: .35; } 50% { opacity: .7; } }

  /* Bar: gold shine sweeping across, twinkling star, glowing code chip */
  .kk-offer--bar.kk-offer--fx { position: relative; overflow: hidden; background: linear-gradient(90deg, #6a2733, var(--kk-offer-maroon) 30%, #8a3443 50%, var(--kk-offer-maroon) 70%, #6a2733); }
  .kk-offer--bar.kk-offer--fx::after { content: ""; position: absolute; top: 0; bottom: 0; left: 0; width: 30%; background: linear-gradient(90deg, transparent, rgba(255,231,170,.28), transparent); animation: kk-shine 4.5s ease-in-out infinite; pointer-events: none; }
  .kk-offer__twinkle { display: inline-block; color: var(--kk-offer-gold); }
  .kk-offer--fx .kk-offer__twinkle { animation: kk-twinkle 1.8s ease-in-out infinite; }
  .kk-offer--fx .kk-offer__code { animation: kk-pulse 2.2s ease-in-out infinite; }

  /* Banner: toran, rising sparkles, diyas, shimmering text, shining button */
  .kk-offer__toran { position: absolute; top: 0; left: -2%; right: -2%; height: 46px; z-index: 1; transform-origin: top center; animation: kk-sway 5s ease-in-out infinite;
    background:
      radial-gradient(circle at 15px 13px, #FFB627 0 7px, #F28C0F 8px 10px, transparent 11px) 0 0 / 30px 26px repeat-x,
      radial-gradient(ellipse at 15px 30px, #2F7D32 0 4px, transparent 5px) 15px 8px / 60px 40px repeat-x,
      linear-gradient(#CDA85C, #CDA85C) 0 12px / 100% 2px no-repeat; }
  .kk-offer__toran::after { content: ""; position: absolute; left: 0; right: 0; top: 24px; height: 22px;
    background: radial-gradient(circle at 30px 6px, #FFB627 0 5px, #E07B00 6px 7px, transparent 8px) 0 0 / 60px 22px repeat-x,
                radial-gradient(circle at 30px 16px, #F28C0F 0 4px, transparent 5px) 0 0 / 60px 22px repeat-x; }
  .kk-offer__sparkles { position: absolute; inset: 0; overflow: hidden; pointer-events: none; }
  .kk-offer__sparkles span { position: absolute; left: var(--x); bottom: -24px; font-size: var(--s); line-height: 1; color: #F3D27A; text-shadow: 0 0 6px rgba(255,214,120,.9); opacity: 0; animation: kk-rise var(--d) linear var(--w) infinite; }
  .kk-diya { position: absolute; bottom: 26px; z-index: 1; width: 64px; height: 64px; }
  .kk-diya--l { left: 34px; } .kk-diya--r { right: 34px; }
  .kk-diya svg { display: block; width: 100%; height: 100%; overflow: visible; }
  .kk-diya__bowl { fill: #B5562B; } .kk-diya__rim { stroke: #E9B04E; stroke-width: 3; stroke-linecap: round; }
  .kk-diya__flame { fill: #FFB627; transform-origin: 32px 32px; transform-box: view-box; animation: kk-flicker 1.4s ease-in-out infinite; }
  .kk-diya__core { fill: #FFF3C4; transform-origin: 32px 30px; transform-box: view-box; animation: kk-flicker 1.1s ease-in-out infinite reverse; }
  .kk-diya__glow { fill: rgba(255,190,80,.45); filter: blur(6px); animation: kk-glow 2s ease-in-out infinite; }
  .kk-offer--fx .kk-offer__title em { background: linear-gradient(90deg, #CDA85C 0%, #FFF0C2 25%, #CDA85C 50%, #FFF0C2 75%, #CDA85C 100%) 0 center / 200% auto; -webkit-background-clip: text; background-clip: text; color: transparent; animation: kk-text-shine 5s linear infinite; }
  .kk-offer--fx .kk-offer__motif { animation: kk-twinkle 2.4s ease-in-out infinite; }
  .kk-offer--fx .kk-offer__code--lg { animation: kk-pulse 2.2s ease-in-out infinite; }
  .kk-offer--fx .kk-offer__btn { position: relative; overflow: hidden; }
  .kk-offer--fx .kk-offer__btn::after { content: ""; position: absolute; top: 0; bottom: 0; left: 0; width: 40%; background: linear-gradient(90deg, transparent, rgba(255,255,255,.55), transparent); animation: kk-shine 3.2s ease-in-out 1s infinite; pointer-events: none; }
  .kk-offer--banner.kk-offer--fx { padding-top: 92px; }
  @media (max-width: 600px) {
    .kk-offer--banner.kk-offer--fx { padding-top: 78px; padding-bottom: 96px; }
    .kk-diya { width: 44px; height: 44px; bottom: 22px; }
    .kk-diya--l { left: 22px; } .kk-diya--r { right: 22px; }
    .kk-offer__toran { height: 40px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .kk-offer--fx *, .kk-offer--fx::after, .kk-offer--fx *::after { animation: none !important; }
    .kk-offer__sparkles { display: none; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Kala Kari offer",
  "tag": "div",
  "settings": [
    { "type": "select", "id": "style", "label": "Style", "default": "bar", "options": [{ "value": "bar", "label": "Slim bar" }, { "value": "banner", "label": "Large banner" }] },
    { "type": "checkbox", "id": "effects", "label": "Festive effects (shine, sparkles, toran, diyas)", "default": true },
    { "type": "text", "id": "code", "label": "Discount code", "default": "NAV10" },
    { "type": "text", "id": "starts", "label": "Show from (YYYY-MM-DD HH:MM:SS +0530)", "default": "2026-10-07 00:00:00 +0530" },
    { "type": "text", "id": "ends", "label": "Hide after (YYYY-MM-DD HH:MM:SS +0530)", "default": "2026-10-19 23:59:59 +0530" },
    { "type": "text", "id": "label", "label": "Small label", "default": "Navratri Offer" },
    { "type": "text", "id": "dates", "label": "Dates text", "default": "Till 19 Oct" },
    { "type": "text", "id": "bar_text", "label": "Bar text", "default": "10% off on orders above ₹3,000 · Use code" },
    { "type": "text", "id": "heading", "label": "Banner heading", "default": "Celebrate Navratri," },
    { "type": "text", "id": "heading_italic", "label": "Banner heading (italic line)", "default": "10% off above ₹3,000." },
    { "type": "textarea", "id": "text", "label": "Banner text" },
    { "type": "text", "id": "button_label", "label": "Banner button label", "default": "Shop & apply code" },
    { "type": "text", "id": "redirect", "label": "Send shoppers to (path)", "default": "/collections/all" },
    { "type": "text", "id": "fine_print", "label": "Fine print" }
  ],
  "presets": [{ "name": "Kala Kari offer" }]
}
{% endschema %}
