{% render 'kk-base' %}

<section class="kk kk-film" id="kk-film-{{ section.id }}">
  <div class="kk-wrap kk-center">
    <span class="kk-eyebrow kk-film__eyebrow kk-rv">{{ section.settings.eyebrow }}</span>
    <h2 class="kk-title kk-film__title kk-rv" data-kk-delay="120">{{ section.settings.heading }}</h2>
    <hr class="kk-rule kk-film__rule">
    <div class="kk-film__frame kk-rv" data-kk-delay="200">
      {%- assign vid_id = 'kk-film-video-' | append: section.id -%}
      {% render 'kk-video', id: vid_id, video: section.settings.video, url: section.settings.video_url, cls: 'kk-film', placeholder: 'hero-apparel-1', aspect: '16 / 9' %}
    </div>
    {%- if section.settings.caption != blank -%}
      <p class="kk-film__cap">{{ section.settings.caption }}</p>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .kk-film { background: var(--kk-ink); padding: 100px 0; }
  .kk-film__eyebrow { color: var(--kk-gold-bright); }
  .kk-film__title { color: var(--kk-ivory); font-size: clamp(30px, 4vw, 50px); }
  .kk-film__rule { background: var(--kk-gold-bright); }
  .kk-film__frame { position: relative; max-width: 1060px; margin: 54px auto 0; border: 1px solid var(--kk-gold); padding: 10px; background: #1f1916; }
  .kk-film__video, .kk-film__frame video, .kk-film__frame svg { width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: cover; display: block; background: #1f1916; }
  .kk-film__sound { position: absolute; right: 26px; bottom: 26px; z-index: 2; background: rgba(247,242,233,.94); border: none; color: var(--kk-ink); font-family: var(--kk-sans); font-size: 12px; letter-spacing: .2em; text-transform: uppercase; padding: 11px 18px; cursor: pointer; transition: background .25s; }
  .kk-film__sound:hover { background: var(--kk-gold-bright); }
  .kk-film__cap { margin: 26px 0 0; font-family: var(--kk-serif); font-style: italic; font-size: 19px; color: #bfb3a4; }
  @media (max-width: 700px) { .kk-film { padding: 70px 0; } .kk-film__sound { right: 16px; bottom: 16px; font-size: 11px; padding: 9px 14px; } }
{% endstylesheet %}

{% schema %}
{
  "name": "Kala Kari film",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "The brand film" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Tradition, Beautifully Worn — the film" },
    { "type": "video", "id": "video", "label": "Video" },
    { "type": "text", "id": "video_url", "label": "Video URL (optional — overrides the video's own file)" },
    { "type": "text", "id": "caption", "label": "Caption", "default": "Chikankari, Jaipuri & Kutchi craft · original score" }
  ],
  "presets": [{ "name": "Kala Kari film" }]
}
{% endschema %}
