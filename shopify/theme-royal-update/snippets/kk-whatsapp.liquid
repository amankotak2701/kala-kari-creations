{% stylesheet %}
  .kk-whatsapp {
    position: fixed;
    right: 20px;
    bottom: 20px;
    z-index: 40;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: #25d366;
    color: #fff;
    box-shadow: 0 6px 18px rgb(0 0 0 / 0.2);
    transition: transform 0.2s ease;
  }

  .kk-whatsapp:hover {
    transform: scale(1.06);
  }

  @media screen and (max-width: 749px) {
    .kk-whatsapp {
      right: 16px;
      bottom: 16px;
      width: 50px;
      height: 50px;
    }
  }
{% endstylesheet %}
