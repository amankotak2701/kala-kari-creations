{% render 'kk-base' %}

<section class="kk kk-styles">
  <div class="kk-wrap kk-center">
    <span class="kk-eyebrow kk-rv">{{ section.settings.eyebrow }}</span>
    <h2 class="kk-title kk-rv" data-kk-delay="120">{{ section.settings.heading }}</h2>
    <hr class="kk-rule">
    <div class="kk-styles__grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign link = block.settings.link
          if link == blank
            assign link = block.settings.collection.url | default: routes.all_products_collection_url
          endif
          assign label = block.settings.title | default: block.settings.collection.title
          assign tile_alt = block.settings.image.alt | default: label
        -%}
        <a class="kk-styles__tile kk-rv" data-kk-delay="{{ forloop.index0 | times: 110 }}" href="{{ link }}" {{ block.shopify_attributes }}>
          <span class="kk-styles__img">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 700 | image_tag: loading: 'lazy', sizes: '(max-width: 800px) 50vw, 25vw', widths: '360, 540, 700', alt: tile_alt }}
            {%- elsif block.settings.collection.featured_image -%}
              {{ block.settings.collection.featured_image | image_url: width: 700 | image_tag: loading: 'lazy', alt: tile_alt }}
            {%- else -%}
              {{ 'collection-2' | placeholder_svg_tag }}
            {%- endif -%}
          </span>
          <span class="kk-styles__label">
            <span class="kk-styles__name">{{ label }}</span>
            {%- if block.settings.note != blank -%}<span class="kk-styles__note">{{ block.settings.note }}</span>{%- endif -%}
          </span>
        </a>
      {%- endfor -%}
    </div>
    {%- if section.settings.show_prices -%}
      <div class="kk-styles__prices kk-rv">
        <span class="kk-styles__prices-label">Shop by price</span>
        <a href="{{ routes.all_products_collection_url }}?filter.v.price.lte=1500" rel="nofollow">Under ₹1,500</a>
        <a href="{{ routes.all_products_collection_url }}?filter.v.price.gte=1500&filter.v.price.lte=2000" rel="nofollow">₹1,500 – ₹2,000</a>
        <a href="{{ routes.all_products_collection_url }}?filter.v.price.gte=2000" rel="nofollow">₹2,000 &amp; above</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .kk-styles { background: var(--kk-ivory-d); padding: 100px 0; }
  .kk-styles__grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 22px; margin-top: 56px; }
  .kk-styles__tile { position: relative; display: block; overflow: hidden; aspect-ratio: 3 / 4; background: var(--kk-ink); }
  .kk-styles__img img, .kk-styles__img svg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: top; transition: transform .9s ease, opacity .4s; }
  .kk-styles__tile::after { content: ""; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(26,18,15,0) 45%, rgba(26,18,15,.78) 100%); transition: background .4s; }
  .kk-styles__tile:hover img { transform: scale(1.06); }
  .kk-styles__label { position: absolute; z-index: 2; left: 0; right: 0; bottom: 0; padding: 22px 20px; text-align: left; color: var(--kk-ivory); }
  .kk-styles__name { display: block; font-family: var(--kk-serif); font-size: 28px; font-weight: 500; line-height: 1.1; }
  .kk-styles__note { display: inline-flex; align-items: center; gap: 8px; margin-top: 8px; font-size: 11px; letter-spacing: .25em; text-transform: uppercase; color: var(--kk-gold-bright); }
  .kk-styles__note::after { content: "\2192"; transition: transform .3s; }
  .kk-styles__tile:hover .kk-styles__note::after { transform: translateX(5px); }
  .kk-styles__prices { display: flex; justify-content: center; align-items: center; flex-wrap: wrap; gap: 12px; margin-top: 44px; }
  .kk-styles__prices-label { font-size: 11px; letter-spacing: .3em; text-transform: uppercase; color: var(--kk-gold); margin-right: 8px; }
  .kk-styles__prices a { padding: 10px 20px; border: 1px solid #cdbfa8; border-radius: 40px; font-size: 14px; color: var(--kk-ink); transition: background .25s, color .25s, border-color .25s; }
  .kk-styles__prices a:hover { background: var(--kk-maroon); border-color: var(--kk-maroon); color: var(--kk-ivory); }
  @media (max-width: 800px) {
    .kk-styles { padding: 70px 0; }
    .kk-styles__grid { grid-template-columns: repeat(2, 1fr); gap: 12px; margin-top: 40px; }
    .kk-styles__name { font-size: 22px; }
    .kk-styles__label { padding: 14px; }
    .kk-styles__prices-label { width: 100%; margin: 0 0 4px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Kala Kari shop by style",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "Find your silhouette" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by style" },
    { "type": "checkbox", "id": "show_prices", "label": "Show shop-by-price links", "default": true }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Style",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Title (defaults to collection name)" },
        { "type": "text", "id": "note", "label": "Link text", "default": "Shop now" },
        { "type": "url", "id": "link", "label": "Custom link (optional)" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [{ "name": "Kala Kari shop by style", "blocks": [{ "type": "tile" }, { "type": "tile" }, { "type": "tile" }, { "type": "tile" }] }]
}
{% endschema %}
