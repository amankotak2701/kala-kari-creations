<defs>
  <linearGradient id="gold" x1="0" y1="0" x2="1" y2="1">
    <stop offset="0" stop-color="#A9823F"/>
    <stop offset="0.45" stop-color="#D9BC79"/>
    <stop offset="0.6" stop-color="#C6A15A"/>
    <stop offset="1" stop-color="#8E6A2E"/>
  </linearGradient>
  <linearGradient id="goldv" x1="0" y1="0" x2="0" y2="1">
    <stop offset="0" stop-color="#D9BC79"/>
    <stop offset="1" stop-color="#9A7535"/>
  </linearGradient>
  <symbol id="emblem" viewBox="-80 -72 160 248" overflow="visible">
    <!-- dotted embroidery outline -->
    <path d="M -66 152 V 60 C -66 14 -31 -1 -12 -15 C -4 -21 0 -30 0 -43 C 0 -30 4 -21 12 -15 C 31 -1 66 14 66 60 V 152"
          fill="none" stroke="url(#gold)" stroke-width="3.2" stroke-linecap="round" stroke-dasharray="0 7.5"/>
    <!-- outer arch -->
    <path d="M -56 152 V 62 C -56 22 -26 8 -9 -4 C -3 -9 0 -18 0 -30 C 0 -18 3 -9 9 -4 C 26 8 56 22 56 62 V 152"
          fill="none" stroke="url(#gold)" stroke-width="4"/>
    <!-- inner arch -->
    <path d="M -47 152 V 65 C -47 32 -22 19 -7 8 C -2 4 0 -3 0 -12 C 0 -3 2 4 7 8 C 22 19 47 32 47 65 V 152"
          fill="none" stroke="url(#gold)" stroke-width="1.4"/>
    <!-- kalash finial -->
    <circle cx="0" cy="-50" r="4.2" fill="url(#gold)"/>
    <path d="M 0 -70 L 3.6 -61 L 0 -55.5 L -3.6 -61 Z" fill="url(#gold)"/>
    <!-- small star under apex -->
    <path d="M 0 14 L 3 21 L 0 28 L -3 21 Z M -7 21 L 0 18.5 L 7 21 L 0 23.5 Z" fill="url(#gold)"/>
    <!-- monogram: K and mirrored K back to back -->
    <g font-family="Cinzel" font-weight="700" font-size="58" fill="var(--mono, #752C39)">
      <text x="-8" y="104" text-anchor="start">K</text>
      <text x="-8" y="104" text-anchor="start" transform="scale(-1,1)">K</text>
    </g>
    <!-- lotus -->
    <g fill="url(#goldv)">
      <path d="M 0 112 C -6 121 -6 131 0 138 C 6 131 6 121 0 112 Z"/>
      <path d="M 0 138 C -4 128 -11 120 -21 118 C -19 128 -11 136 0 138 Z"/>
      <path d="M 0 138 C 4 128 11 120 21 118 C 19 128 11 136 0 138 Z"/>
    </g>
    <!-- plinth -->
    <rect x="-64" y="150" width="128" height="4.5" fill="url(#gold)"/>
    <rect x="-72" y="159" width="144" height="1.6" fill="url(#gold)"/>
  </symbol>
</defs>
